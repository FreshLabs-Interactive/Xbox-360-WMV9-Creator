<Window x:Class="XboxWMVCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xbox 360 Video Converter" Height="600" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        AllowDrop="True">
    <Grid Margin="10">

        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Width="350">

            <TextBlock Text="Xbox 360 WMV9 Converter" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,10" />
            
            <TextBlock Text="Queue List" FontSize="14" FontWeight="Bold" TextAlignment="Center" Margin="0,20,0,0" />
            <!-- Queue List -->
            <ListBox Name="QueueListBox" Height="200" Margin="0,0,0,30" SelectionMode="Extended" AllowDrop="True">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Remove from Queue" Click="RemoveFromQueue_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- Add local files -->
            <Button Content="Select Files To Add To Queue" Click="SelectFileButton_Click" Margin="0,0,0,20" Height="30" Width="200"/>



            <Button Content="Add YouTube URL To Queue" Click="DownloadUrlButton_Click" Height="30" Margin="0,0,0,10" Width="200" />

            <!-- Start conversion -->
            <Button Content="Convert Videos" Click="ConvertButton_Click" Height="40" FontWeight="Bold" Margin="0,0,0,10" Width="150" />
            <Button Content="View Output Folder" Click="ViewOutputFolderButton_Click" Height="40" Margin="0,0,0,10" Width="150"/>
            
            
            <!-- View output -->

            <TextBlock Text="Made By JFresh ©2025" FontSize="8" TextAlignment="Center" Margin="0,20,0,0" />

        </StackPanel>

    </Grid>
</Window>
